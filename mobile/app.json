{
  "expo": {
    "name": "Pinley",
    "slug": "pinley",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "icon": "./assets/images/pinley_image.png",
    "scheme": "pinley",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Pinley uses your location to show where you are on the map."
      }
    },
    "android": {
      "package": "com.infinityquestlabs.pinley",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/pinley_image.png",
        "backgroundImage": "./assets/images/pinley_image.png",
        "monochromeImage": "./assets/images/pinley_image.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/pinley_image.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/pinley_image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
